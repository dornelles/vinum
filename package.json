{
  "name": "vnum-v2.0",
  "private": true,
  "version": "2.14.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "tsx backend/src/server.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:push": "npm run prisma:deploy",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:deploy": "tsx backend/scripts/deploy.ts",
    "prisma:seed": "prisma db seed --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.0.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.3",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
